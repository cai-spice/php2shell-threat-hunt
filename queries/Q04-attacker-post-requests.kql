// ============================================================================
//  ID:             Q04  (report appendix: A3, second query)
//  Name:           POST requests from the attacker, newest first
//  Purpose:        List the exploit POSTs and find the last one before the web shell appeared.
//  Hunt step:      4
//  ATT&CK:         T1190 Exploit Public-Facing Application
//  Tables:         HartwellHTTPEnriched_CL
//  Time range:     2026-10-23 04:00 to 16:00 UTC
//  Environment:    Practice lab
//  Hit looks like: A cluster of POST requests with multipart/form-data content type.
//  Result:         The last exploit POST arrived at 09:57 UTC.
//  Benign noise:   Legitimate form posts. The IP filter limits this to the outlier.
//  Tuning notes:   Replace the IP with the outlier from Q01.
//  Author / date:  Cai Spice · hunt run 2026-10-23, documented 2026-11-20
// ============================================================================

HartwellHTTPEnriched_CL
| where OriginalTime between (datetime(2026-10-23T04:00:00Z) .. datetime(2026-10-23T16:00:00Z))
| where id_orig_h == "192.168.1.100"
| where method == "POST"
| project method, content_type, OriginalTime
| order by OriginalTime desc
